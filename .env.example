# Database Configuration
# Per PostgreSQL locale, usa questo format:
# postgresql://username:password@localhost:5432/eventplan
#
# Se usi Docker, assicurati che il servizio sia in esecuzione
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventplan"
# pg pool (defaults shown)
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Node Environment
NODE_ENV="development"

# Port
PORT=3000

# Prometheus metrics (GET /metrics) on a dedicated port. Internal network only:
# never publish it from the container, never proxy it through nginx.
METRICS_PORT=9091

# Bastion (IdP — JWT RS256)
BASTION_URL=http://bastion:8080
BASTION_APP_SLUG=gatherly
BASTION_CLIENT_API_KEY=sc_xxxx...
# BASTION_TENANT_SLUG=   # only for single-tenant setups
# Matches Bastion's JWKS Cache-Control: max-age (JWKS_CACHE_MAX_AGE_SECONDS = 300s)
BASTION_JWKS_TTL_MS=300000
# Admin API: appSlug allowlist for Bastion user-JWTs. Add the central console app (meridian).
ADMIN_ACCEPTED_APP_SLUGS=gatherly,meridian
# Admin API: Bastion roles allowed (aligned with the console login check).
ADMIN_ACCEPTED_ROLES=ADMIN,OWNER,SUPER_ADMIN,MODERATOR,AUTHOR
