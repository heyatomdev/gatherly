// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── CLIENT ─────────────────────────────────────────────────────────────────

model Client {
  id        String    @id @default(uuid())
  name      String
  token     String    @unique
  tenantId  String?   @unique
  isActive  Boolean   @default(true)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  defaultLocale String  @default("it") // fallback lingua
  emailActive   Boolean @default(false)
  webhookUrl    String?

  webhookSecret String?

  events            Event[]
  eventCategories   EventCategory[]
  tags              Tag[]
  webhookDeliveries WebhookDelivery[]

  @@map("clients")
}

// ─── CATEGORY + i18n ────────────────────────────────────────────────────────

model EventCategory {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  color    String?
  icon     String?

  translations EventCategoryTranslation[]
  events       Event[]

  @@index([clientId])
  @@map("event_categories")
}

model EventCategoryTranslation {
  id         String        @id @default(uuid())
  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String // "it", "en"
  name       String

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("event_category_translations")
}

// ─── RECURRENCE (estratto) ──────────────────────────────────────────────────

model RecurrenceRule {
  id      String    @id @default(uuid())
  rule    String // RRULE iCal: FREQ=WEEKLY;BYDAY=MO,WE
  endDate DateTime?
  count   Int?

  events Event[]

  @@map("recurrence_rules")
}

// ─── EVENT + i18n ───────────────────────────────────────────────────────────

model Event {
  id            String @id @default(uuid())
  clientId      String
  client        Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  defaultLocale String @default("it")

  // Author (può essere external, manteniamo snapshot)
  authorId    String
  authorName  String
  authorEmail String?

  startTime     DateTime
  endTime       DateTime?
  timezone      String      @default("Europe/Rome")
  status        EventStatus @default(DRAFT)
  type          String? // "lesson", "gaming", "seminar" — libero per flessibilità
  coverImageUrl String?

  categoryId String?
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  locationName    String?
  locationAddress String?
  locationUrl     String?
  isOnline        Boolean @default(false)

  maxParticipants Int?
  isPublic        Boolean @default(true)

  price    Decimal? @db.Decimal(10, 2)
  currency String?  @default("EUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recurrence — ora FK pulita
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  parentEventId    String?
  parentEvent      Event?          @relation("EventRecurrence", fields: [parentEventId], references: [id], onDelete: Cascade)
  childEvents      Event[]         @relation("EventRecurrence")

  translations EventTranslation[]
  participants Participant[]
  tags         EventTag[]

  @@index([clientId])
  @@index([clientId, startTime])
  @@index([categoryId])
  @@index([parentEventId])
  @@index([status])
  @@index([startTime])
  @@map("events")
}

model EventTranslation {
  id          String  @id @default(uuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locale      String // "it", "en"
  title       String
  description String?

  @@unique([eventId, locale])
  @@index([eventId])
  @@index([locale])
  @@map("event_translations")
}

// ─── TAG ─────────────────────────────────────────────────────────────────────

model Tag {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slug     String  // lowercase, normalizzato: "5v5", "yoga", "competitive"
  label    Json?   // label localizzata: {"it": "Competitivo", "en": "Competitive"}

  events EventTag[]

  @@unique([clientId, slug])
  @@index([clientId])
  @@map("tags")
}

model EventTag {
  eventId String
  tagId   String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@map("event_tags")
}

// ─── PARTICIPANT ─────────────────────────────────────────────────────────────

enum ParticipantType {
  INLINE // dati forniti direttamente, nessun account
  EXTERNAL // utente da app terza, identificato da externalId
}

model Participant {
  id      String          @id @default(uuid())
  eventId String
  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type    ParticipantType @default(INLINE)

  // INLINE — dati diretti
  userName String
  email    String?

  // EXTERNAL — riferimento app terza
  externalId     String? // ID utente nell'app chiamante
  externalSource String? // "discord", "steam", "myapp" — slug libero

  status      ParticipantStatus @default(REGISTERED)
  role        ParticipantRole   @default(ATTENDEE)
  notes       String?
  checkedIn   Boolean           @default(false)
  checkedInAt DateTime?
  createdAt   DateTime          @default(now())

  // Escape hatch per dati domain-specific (rank, team, membership, ecc.)
  metadata Json?

  // Unique: un utente esterno unico per evento+source
  // Per INLINE usiamo solo id (no unique su email, può partecipare più volte con ruoli diversi)
  @@unique([eventId, externalId, externalSource])
  @@index([eventId])
  @@index([externalId])
  @@index([email])
  @@index([status])
  @@map("participants")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ParticipantStatus {
  REGISTERED
  WAITLIST
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum ParticipantRole {
  ATTENDEE
  SPEAKER
  ORGANIZER
  HOST
}

// ─── WEBHOOK DELIVERY ────────────────────────────────────────────────────────

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id          String                @id @default(uuid())
  clientId    String
  client      Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventType   String
  payload     Json
  webhookUrl  String
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)
  nextRetryAt DateTime              @default(now())
  lastError   String?
  status      WebhookDeliveryStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([clientId])
  @@map("webhook_deliveries")
}

// ─── IDEMPOTENCY KEYS ────────────────────────────────────────────────────────

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  clientId     String
  path         String
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([key, clientId, path])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
